<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Finora" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1E3A5F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/finora_round</item>
        <item name="postSplashScreenTheme">@style/Theme.Finora</item>
    </style>
</resources>
